{
  "hosting": {
    "site": "treespotter",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "tree-spotter-api",
          "region": "australia-southeast1"
        }
      },

      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
